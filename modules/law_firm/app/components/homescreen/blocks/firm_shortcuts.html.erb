<%=
  widget_wrapper do |container|
    shortcuts.each do |shortcut|
      container.with_row(test_selector: "firm-shortcut-#{shortcut.key}") do
        flex_layout(align_items: :center) do |row|
          row.with_column(mr: 2) do
            render(Primer::Beta::Octicon.new(icon: shortcut.icon, color: :muted))
          end
          row.with_column(flex: 1) do
            component_collection do |body|
              body.with_component(
                render(Primer::Beta::Link.new(href: shortcut.href, font_weight: :bold)) do
                  t("law_firm.shortcuts.#{shortcut.key}.label")
                end
              )
              body.with_component(
                render(Primer::Beta::Text.new(tag: :p, color: :subtle, font_size: :small)) do
                  t("law_firm.shortcuts.#{shortcut.key}.description")
                end
              )
            end
          end
        end
      end
    end
  end
%>
