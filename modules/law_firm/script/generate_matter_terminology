# Law firm customization: generates English locale overrides that call
# projects "matters". Re-run after merging upstream locale changes:
#
#   ruby modules/law_firm/script/generate_matter_terminology
#
# The result is loaded last by OpenProject::LawFirm::Engine.

require "yaml"

ROOT = File.expand_path("../../..", __dir__)
OUTPUT = File.join(ROOT, "modules/law_firm/config/matter_terminology/en.yml")

SOURCES = (
  Dir[File.join(ROOT, "config/locales/{en,js-en}.yml")] +
  Dir[File.join(ROOT, "modules/*/config/locales/{en,js-en}.yml")]
).sort

# Placeholders, markup, code spans and paths must keep their original spelling.
PROTECTED = Regexp.new(<<~'RE', Regexp::EXTENDED)
  %\{[^}]*\} | %<[^>]*>[a-z] | \{\{[^}]*\}\} | <[^>]*> | `[^`]*` |
  https?://\S+ | [\w.-]*/[\w./:-]* | \w+\.\w+\(\)
RE

# "Projects" that belong to other tools keep their name.
EXTERNAL = /(?:Jira|GitLab|GitHub|SquashTM|Squash TM|Azure DevOps|Linear)\s+\z/i

WORD = /\b(sub-?)?(projects|project)\b/i

def matterize(word)
  plural = word.downcase.end_with?("s")
  base = plural ? "matters" : "matter"
  if word == word.upcase && word.length > 1
    base.upcase
  elsif word[0] == word[0].upcase
    base.capitalize
  else
    base
  end
end

def replace_words(text)
  text.gsub(WORD) do
    match = Regexp.last_match
    prefix, word = match[1], match[2]
    before = match.pre_match
    next match[0] if before.match?(EXTERNAL)

    if prefix
      sub = prefix[0] == "S" ? "Sub-" : "sub-"
      "#{sub}#{matterize(word).downcase}"
    else
      matterize(word)
    end
  end
end

def rewrite(text)
  parts = []
  last = 0
  text.scan(PROTECTED) do
    m = Regexp.last_match
    parts << replace_words(text[last...m.begin(0)]) << m[0]
    last = m.end(0)
  end
  parts << replace_words(text[last..])
  parts.join
end

def placeholders(text)
  text.scan(/%\{[^}]*\}|%<[^>]*>[a-z]|\{\{[^}]*\}\}/).sort
end

def collect(node, path, out)
  case node
  when Hash
    node.each { |key, value| collect(value, path + [key.to_s], out) }
  when String
    rewritten = rewrite(node)
    return if rewritten == node

    raise "Placeholder changed in #{path.join('.')}" unless placeholders(rewritten) == placeholders(node)

    out[path] = rewritten
  when Array
    rewritten = node.map { |v| v.is_a?(String) ? rewrite(v) : v }
    out[path] = rewritten unless rewritten == node
  end
end

overrides = {}
SOURCES.each do |file|
  data = YAML.safe_load_file(file, aliases: true, permitted_classes: [Symbol])
  collect(data.fetch("en", {}), ["en"], overrides)
end

tree = {}
overrides.sort_by { |path, _| path }.each do |path, value|
  *parents, leaf = path
  parents.reduce(tree) { |node, key| node[key] ||= {} }[leaf] = value
end

header = <<~TXT
  # Generated by modules/law_firm/script/generate_matter_terminology. Do not edit by hand:
  # change the script and run it again.
TXT

File.write(OUTPUT, header + YAML.dump(tree, line_width: -1))
puts "Wrote #{overrides.size} overrides to #{OUTPUT.delete_prefix("#{ROOT}/")}"
