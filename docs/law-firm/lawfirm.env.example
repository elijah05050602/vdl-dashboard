# Copy to .env (Docker) or export before starting the dashboard.
# In development and production these names are already the defaults, so this file
# is only needed to change them.
OPENPROJECT_APP__TITLE="VDL Dashboard"
OPENPROJECT_ORGANIZATION__NAME="Law Offices of Villanueva, Dorin & Lozano"
# Sender shown on notification emails. Replace the address with the firm's real mailbox.
OPENPROJECT_MAIL__FROM="VDL Dashboard <dashboard@example.com>"
OPENPROJECT_DEFAULT__LANGUAGE="en"
OPENPROJECT_SEED__LOCALE="en"
# Lets lawyers install the dashboard on their phones from the browser ("Add to Home screen").
# Already on in development. Phones can only install it from an https:// address.
OPENPROJECT_FEATURE_PROGRESSIVE_WEB_APP_ACTIVE="true"
