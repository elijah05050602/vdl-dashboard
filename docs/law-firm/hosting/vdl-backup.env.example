# /etc/vdl-backup.env  (chmod 600, owner root)
# Keep a copy of this passphrase OFFLINE (printed, in the firm's safe). Without it the backups cannot be opened.
BACKUP_PASSPHRASE=replace-with-a-long-random-passphrase
DB_NAME=vdl_dashboard
ATTACHMENTS_DIR=/var/lib/vdl-dashboard/files
BACKUP_DIR=/var/backups/vdl-dashboard
KEEP_DAYS=14
# Off-site copy (set up with: rclone config). Example for a Backblaze B2 bucket:
RCLONE_REMOTE=b2:vdl-dashboard-backups
