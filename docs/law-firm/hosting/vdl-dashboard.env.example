# /etc/vdl-dashboard.env  (chmod 600, owner vdl). Read by both systemd services.
RAILS_ENV=production
HOST=127.0.0.1
PORT=6000
DATABASE_URL=postgres:///vdl_dashboard
SECRET_KEY_BASE=replace-with-output-of-openssl-rand-hex-64
OPENPROJECT_HOST__NAME=dashboard.vdl-law.ph
OPENPROJECT_HTTPS=true
OPENPROJECT_ATTACHMENTS__STORAGE__PATH=/var/lib/vdl-dashboard/files
OPENPROJECT_APP__TITLE="VDL Dashboard"
OPENPROJECT_ORGANIZATION__NAME="Law Offices of Villanueva, Dorin & Lozano"
OPENPROJECT_USER__DEFAULT__TIMEZONE=Asia/Manila
OPENPROJECT_DEFAULT__LANGUAGE=en
RAILS_SERVE_STATIC_FILES=false
# Email (HOSTING.md section 6)
OPENPROJECT_EMAIL__DELIVERY__METHOD=smtp
OPENPROJECT_SMTP__ADDRESS=smtp-relay.brevo.com
OPENPROJECT_SMTP__PORT=587
OPENPROJECT_SMTP__AUTHENTICATION=login
OPENPROJECT_SMTP__ENABLE__STARTTLS__AUTO=true
OPENPROJECT_SMTP__USER__NAME=replace-me
OPENPROJECT_SMTP__PASSWORD=replace-me
OPENPROJECT_MAIL__FROM="VDL Dashboard <dashboard@vdl-law.ph>"
