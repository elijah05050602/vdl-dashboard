# /etc/systemd/system/vdl-dashboard-web.service
[Unit]
Description=VDL Dashboard web server
After=network.target postgresql.service

[Service]
User=vdl
WorkingDirectory=/opt/vdl-dashboard
EnvironmentFile=/etc/vdl-dashboard.env
Environment=PATH=/home/vdl/.rbenv/shims:/home/vdl/.rbenv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/vdl-dashboard/packaging/scripts/web
Restart=always

[Install]
WantedBy=multi-user.target
