{
  "name": "law-firm-dashboard-desktop",
  "productName": "Law Firm Dashboard",
  "version": "1.0.0",
  "description": "Windows desktop app for the Law Firm Dashboard",
  "main": "src/main.js",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Law Firm Dashboard",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.lawfirm.dashboard",
    "productName": "Law Firm Dashboard",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "artifactName": "Law-Firm-Dashboard-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Law Firm Dashboard",
      "uninstallDisplayName": "Law Firm Dashboard",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  }
}
