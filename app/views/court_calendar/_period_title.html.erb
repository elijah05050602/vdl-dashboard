<% case calendar.view %>
<% when "month" %>
  <%= I18n.l(calendar.date, format: "%B %Y") %>
<% when "week" %>
  <%= t("court_calendar.week_title", from: I18n.l(calendar.days.first, format: :long), to: I18n.l(calendar.days.last, format: :long)) %>
<% else %>
  <%= I18n.l(calendar.date, format: "%A, %B %-d, %Y") %>
<% end %>
