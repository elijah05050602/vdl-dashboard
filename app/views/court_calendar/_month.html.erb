<div class="court-calendar--scroll">
  <table class="court-calendar--grid" data-test-selector="court-calendar-month">
    <thead>
      <tr>
        <% calendar.weeks.first.each do |day| %>
          <th scope="col"><%= I18n.t("date.abbr_day_names")[day.wday] %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% calendar.weeks.each do |week| %>
        <tr>
          <% week.each do |day| %>
            <%
              classes = []
              classes << "-outside" unless calendar.in_period?(day)
              classes << "-non-working" unless calendar.working_day?(day)
            %>
            <td class="<%= classes.join(" ") %>" data-date="<%= day.iso8601 %>">
              <%= link_to day.day,
                          court_calendar_link(view: "day", date: day.iso8601),
                          class: ["court-calendar--day-number", ("-today" if day == current_user.today)].compact.join(" ") %>
              <% if (holiday = calendar.holiday_name(day)) %>
                <span class="court-calendar--holiday"><%= holiday %></span>
              <% end %>
              <% calendar.entries_on(day).each do |entry| %>
                <%
                  chip_label = [entry.time, entry.work_package.project.name, entry.kind].compact.join(" · ")
                  details = [entry.work_package.subject, entry.court, entry.branch, entry.lawyer&.name].compact_blank.join(" · ")
                %>
                <%= link_to chip_label.presence || entry.work_package.subject,
                            work_package_path(entry.work_package),
                            class: ["court-calendar--chip", ("-closed" if entry.closed?)].compact.join(" "),
                            aria: { label: [chip_label, details].compact_blank.join(" · ") },
                            data: { test_selector: "court-calendar-entry" } %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
