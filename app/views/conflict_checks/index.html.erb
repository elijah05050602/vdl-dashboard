<% html_title t(:label_conflict_check) -%>

<%=
  render Primer::OpenProject::PageHeader.new do |header|
    header.with_title { t(:label_conflict_check) }
    header.with_description { t("conflict_check.caption") }
    header.with_breadcrumbs([{ href: home_path, text: t(:label_home) }, t(:label_conflict_check)])
  end
%>

<%= form_tag conflict_check_path, method: :get, class: "conflict-check--form" do %>
  <%= render Primer::Box.new(display: :flex, flex_wrap: :wrap, align_items: :flex_end, mb: 3, style: "gap: 8px; max-width: 640px;") do %>
    <%= render Primer::Box.new(flex: 1, style: "min-width: 200px;") do %>
      <%= render Primer::Alpha::TextField.new(
            name: :q,
            id: "conflict-check-query",
            label: t("conflict_check.query_label"),
            placeholder: t("conflict_check.query_placeholder"),
            value: @search.query,
            full_width: true,
            autofocus: true
          ) %>
    <% end %>
    <%= render Primer::Beta::Button.new(type: :submit, scheme: :primary) do |button|
          button.with_leading_visual_icon(icon: :search)
          t("conflict_check.submit")
        end %>
  <% end %>
<% end %>

<%= render Primer::Beta::Text.new(tag: :p, color: :subtle, font_size: :small, mb: 3) do %>
  <%= t("conflict_check.scope_note") %>
<% end %>

<% if @search.searchable? %>
  <% if @matches.empty? %>
    <%= render Primer::Alpha::Banner.new(scheme: :success, icon: :check, mb: 3, test_selector: "conflict-check-result") do %>
      <%= t("conflict_check.no_matches", query: @search.query) %>
    <% end %>
  <% else %>
    <%= render Primer::Alpha::Banner.new(scheme: :warning, icon: :alert, mb: 3, test_selector: "conflict-check-result") do %>
      <%= t("conflict_check.matches_found", count: @matches.size, query: @search.query) %>
    <% end %>

    <%= render Primer::Beta::BorderBox.new(test_selector: "conflict-check-matches") do |box| %>
      <% box.with_header do %>
        <%= render Primer::Box.new(display: [:none, nil, :flex], font_weight: :bold) do %>
          <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %><%= t("conflict_check.column_matter") %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %><%= t("conflict_check.column_field") %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 4], mb: [1, nil, 0]) do %><%= t("conflict_check.column_value") %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 2], mb: [1, nil, 0]) do %><%= t("conflict_check.column_role") %><% end %>
        <% end %>
      <% end %>
      <% @matches.each do |match| %>
        <% box.with_row do %>
          <%= render Primer::Box.new(display: [:block, nil, :flex], align_items: :center) do %>
            <% if match.restricted %>
              <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %>
                <%= render Primer::Beta::Octicon.new(icon: :lock, color: :muted, mr: 1) %>
                <%= t("conflict_check.restricted_matter", identifier: match.project.identifier) %>
                <% if match.archived? %>
                  <%= render Primer::Beta::Label.new(scheme: :secondary, ml: 1) do %><%= t("conflict_check.archived") %><% end %>
                <% end %>
              <% end %>
              <%= render Primer::Box.new(col: [nil, nil, 7], mb: [1, nil, 0], color: :muted) do %>
                <%= t("conflict_check.restricted_hint") %>
              <% end %>
            <% else %>
              <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %>
                <% if match.archived? %>
                  <%= match.project.name %>
                  <%= render Primer::Beta::Label.new(scheme: :secondary, ml: 1) do %><%= t("conflict_check.archived") %><% end %>
                <% else %>
                  <%= link_to match.project.name, project_path(match.project) %>
                <% end %>
              <% end %>
              <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %>
                <%= match.source || t("conflict_check.field_matter_name") %>
              <% end %>
              <%= render Primer::Box.new(col: [nil, nil, 4], mb: [1, nil, 0]) do %>
                <%= truncate(match.value.to_s, length: 160) %>
              <% end %>
            <% end %>
            <%= render Primer::Box.new(col: [nil, nil, 2], mb: [1, nil, 0]) do %>
              <%= render Primer::Beta::Label.new(
                    scheme: { opposing: :danger, client: :attention, matter: :accent, other: :secondary }[match.role]
                  ) do %>
                <%= t("conflict_check.roles.#{match.role}") %>
              <% end %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>

<% if @recent_logs.present? %>
  <%= render Primer::Beta::Heading.new(tag: :h3, mt: 5, mb: 2) do %>
    <%= t("conflict_check.log_heading") %>
  <% end %>
  <%= render Primer::Beta::BorderBox.new(test_selector: "conflict-check-log") do |box| %>
    <% @recent_logs.each do |log| %>
      <% box.with_row do %>
        <%= render Primer::Box.new(display: [:block, nil, :flex]) do %>
          <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %><%= format_time(log.created_at) %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 3], mb: [1, nil, 0]) do %><%= log.user&.name %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 4], mb: [1, nil, 0]) do %><%= log.query %><% end %>
          <%= render Primer::Box.new(col: [nil, nil, 2], mb: [1, nil, 0]) do %>
            <%= t("conflict_check.log_matches", count: log.matches_count) %>
          <% end %>
        <% end %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
