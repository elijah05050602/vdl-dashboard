<%=
  widget_wrapper do |container|
    if deadlines.empty?
      container.with_body do
        render(Primer::Beta::Blankslate.new(test_selector: "upcoming-deadlines-widget-empty")) do |component|
          component.with_visual_icon(icon: :calendar)
          component.with_heading(tag: :h4).with_content(t("law_firm.deadlines.widget.empty_heading"))
          component.with_description { t("law_firm.deadlines.widget.empty_description", days: LawFirm::Deadlines::LOOKAHEAD_DAYS) }
        end
      end
    else
      deadlines.each do |work_package|
        container.with_row(test_selector: "upcoming-deadlines-widget-row") do
          flex_layout(justify_content: :space_between, align_items: :flex_start) do |row|
            row.with_column(mr: 2) do
              component_collection do |body|
                body.with_component(
                  render(Primer::Beta::Link.new(href: work_package_path(work_package), font_weight: :bold)) { work_package.subject }
                )
                body.with_component(
                  render(Primer::Beta::Text.new(tag: :p, color: :subtle, font_size: :small)) do
                    [work_package.type.name, work_package.project.name].join(" · ")
                  end
                )
              end
            end
            row.with_column(text_align: :right) do
              component_collection do |body|
                body.with_component(
                  render(Primer::Beta::Label.new(scheme: date_scheme(work_package), test_selector: "upcoming-deadlines-widget-label")) do
                    date_label(work_package)
                  end
                )
                body.with_component(
                  render(Primer::Beta::Text.new(tag: :p, color: overdue?(work_package) ? :danger : :subtle, font_size: :small)) do
                    helpers.format_date(work_package.due_date)
                  end
                )
              end
            end
          end
        end
      end
    end

    container.with_footer do
      flex_layout(direction: :row) do |links|
        if (upcoming = query_link(:upcoming_deadlines))
          links.with_column(mr: 3) do
            render(Primer::Beta::Link.new(href: upcoming)) { t("law_firm.deadlines.widget.view_upcoming") }
          end
        end
        if (overdue = query_link(:overdue_deadlines))
          links.with_column do
            render(Primer::Beta::Link.new(href: overdue, scheme: :primary)) { t("law_firm.deadlines.widget.view_overdue") }
          end
        end
      end
    end
  end
%>
